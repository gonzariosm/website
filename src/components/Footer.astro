---
import { copy, markdownPath, homePath, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const other: Locale = locale === 'en' ? 'es' : 'en';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {t.footer.rights}</p>
    <p class="footer__muted">{t.footer.built}</p>
    <ul role="list" class="footer__links">
      <li><a href={markdownPath(locale)} type="text/markdown">{t.footer.markdown}</a></li>
      <li>
        <a href={homePath(other)} hreflang={other} lang={other}>{t.langSwitch.full}</a>
      </li>
      <li><a href="#top">{t.footer.top}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: 32px max(32px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .footer__muted {
    color: var(--muted);
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0 0 0 auto;
  }

  .footer__links a {
    color: var(--ink-2);
    text-decoration-color: var(--line-strong);
  }

  .footer__links a:hover {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .footer__links {
      margin-left: 0;
    }
  }
</style>
