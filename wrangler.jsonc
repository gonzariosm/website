// Cloudflare Workers deployment: an assets-only Worker (no server code) that
// serves the static Astro build. public/_headers (security headers, UTF-8
// content types, caching) is honoured by Workers static assets.
// See docs/adr/website/0007 in the private repo.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gonzalorios",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Production domains. Kept in config so every deploy (including Workers
  // Builds) preserves them. www is attached so it resolves and has a
  // certificate; a zone Redirect Rule (www -> apex, 301) runs before the Worker.
  "routes": [
    { "pattern": "gonzalorios.cl", "custom_domain": true },
    { "pattern": "www.gonzalorios.cl", "custom_domain": true }
  ],
  "observability": { "enabled": false },
  "workers_dev": true,
  "preview_urls": true
}
