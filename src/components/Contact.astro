---
import Icon from './Icon.astro';
import ListenButton from './ListenButton.astro';
import { copy, person, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const c = t.contact;
const newTab = locale === 'en' ? '(opens in a new tab)' : '(se abre en una pestaña nueva)';
---

<section id="contact" class="section contact" aria-labelledby="contact-title" data-section="contact">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container contact__inner">
    <div class="section-head__row">
      <span class="eyebrow" data-reveal>{c.eyebrow}</span>
      <div data-reveal><ListenButton locale={locale} clip="contact" sectionTitle={t.nav.contact} /></div>
    </div>
    <h2 id="contact-title" class="display contact__title" data-reveal>
      {c.title} <span class="accent">{c.accent}</span>
    </h2>
    <p class="lead" data-reveal>{c.body}</p>

    <a class="contact__email" href={`mailto:${person.email}`} data-reveal data-magnetic>
      <span class="visually-hidden">{c.email}: </span>
      <span class="contact__email-text">{person.email}</span>
      <span class="contact__email-icon" aria-hidden="true"><Icon name="arrow-up-right" /></span>
    </a>

    <div class="contact__actions" data-reveal>
      <button type="button" class="btn" data-copy-email={person.email} data-copied-label={c.copied} hidden>
        <Icon name="copy" />
        <span data-copy-label>{c.copy}</span>
      </button>
      <a class="btn btn--ghost" href={person.linkedin} rel="me noopener" target="_blank">
        {c.linkedin} <Icon name="arrow-up-right" />
        <span class="visually-hidden">{newTab}</span>
      </a>
      <p class="contact__location">{c.location}</p>
    </div>
    <p class="visually-hidden" role="status" data-copy-status></p>
  </div>
</section>

<style>
  .contact {
    overflow: clip;
    isolation: isolate;
    padding-bottom: clamp(80px, 10vw, 140px);
  }

  .contact__glow {
    position: absolute;
    inset: 20% -20% -40%;
    z-index: -1;
    background: radial-gradient(45% 50% at 50% 60%, color-mix(in srgb, var(--glow) 85%, transparent), transparent 70%);
    filter: blur(30px);
  }

  .contact__inner {
    display: grid;
    gap: 28px;
  }

  .contact__title {
    max-width: 14ch;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    justify-self: start;
    max-width: 100%;
    margin-top: 12px;
    font-weight: 600;
    font-size: clamp(1.5rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact__email-text {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }

  .contact__email:hover .contact__email-text,
  .contact__email:focus-visible .contact__email-text {
    background-size: 100% 2px;
  }

  .contact__email-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(44px, 6vw, 72px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    transition: transform 0.5s var(--ease-out);
  }

  .contact__email:hover .contact__email-icon {
    transform: rotate(45deg);
  }

  .contact__email-icon :global(svg) {
    width: 45%;
    height: 45%;
  }

  .contact__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .contact__actions [hidden] {
    display: none;
  }

  .contact__location {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .contact__location {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
