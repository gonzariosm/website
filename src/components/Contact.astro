---
import Icon from './Icon.astro';
import ListenButton from './ListenButton.astro';
import { copy, person, type Locale } from '../content/site';
import { cvDownloads } from '../lib/cv';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const c = t.contact;
const cv = cvDownloads(locale);
---

<section id="contact" class="section contact" aria-labelledby="contact-title" data-section="contact">
  <div class="contact__glow" aria-hidden="true"></div>
  <div class="container contact__inner">
    <div class="section-head__row">
      <span class="eyebrow" data-reveal>{c.eyebrow}</span>
      <div data-reveal><ListenButton locale={locale} clip="contact" sectionTitle={t.nav.contact} /></div>
    </div>
    <h2 id="contact-title" class="display contact__title" data-reveal>
      {c.title} <span class="accent">{c.accent}</span>
    </h2>
    <p class="lead" data-reveal>{c.body}</p>

    <a class="contact__email" href={`mailto:${person.email}`} data-reveal data-magnetic>
      <span class="visually-hidden">{c.email}: </span>
      <span class="contact__email-text">{person.email}</span>
      <span class="contact__email-icon" aria-hidden="true"><Icon name="arrow-up-right" /></span>
    </a>

    <div class="contact__meta" data-reveal>
      <button type="button" class="contact__link" data-copy-email={person.email} data-copied-label={c.copied} data-failed-label={c.copyFailed} hidden>
        <Icon name="copy" />
        <span data-copy-label>{c.copy}</span>
      </button>
      <a class="contact__link" href={person.linkedin} rel="me noopener" target="_blank">
        {c.linkedin}
        <Icon name="arrow-up-right" />
        <span class="visually-hidden">{` (${c.newTab})`}</span>
      </a>
      <p class="contact__location">{c.location}</p>
    </div>
    <p class="visually-hidden" role="status" data-copy-status></p>

    <article class="cv" aria-labelledby="cv-title" data-reveal>
      <div class="cv__paper" aria-hidden="true">
        <span class="cv__sheet cv__sheet--back"></span>
        <span class="cv__sheet">
          <i class="cv__line cv__line--name"></i>
          <i class="cv__line cv__line--role"></i>
          <i class="cv__line"></i>
          <i class="cv__line"></i>
          <i class="cv__line cv__line--short"></i>
          <i class="cv__line"></i>
          <i class="cv__line cv__line--short"></i>
        </span>
      </div>
      <div class="cv__body">
        <h3 id="cv-title" class="cv__title">{t.cv.title}</h3>
        <p class="cv__lead">{t.cv.lead}</p>
        <p class="cv__meta">
          PDF{cv.pdfPages && ` · ${cv.pdfPages} ${t.cv.pages}`}{cv.pdfKb && ` · ${cv.pdfKb} KB`}
        </p>
      </div>
      <div class="cv__actions">
        <a class="btn" href={cv.pdf} download type="application/pdf">
          <Icon name="download" />
          {t.cv.pdf}
        </a>
        <p class="cv__alt">
          {t.cv.alsoAs}{' '}
          <a href={cv.json} type="application/json" target="_blank" rel="noopener">
            {t.cv.json}<Icon name="arrow-up-right" /><span class="visually-hidden">{` (${c.newTab})`}</span>
          </a>
          <span aria-hidden="true"> · </span>
          <a href={cv.tex} type="text/x-tex" target="_blank" rel="noopener">
            {t.cv.latex}<Icon name="arrow-up-right" /><span class="visually-hidden">{` (${c.newTab})`}</span>
          </a>
        </p>
      </div>
    </article>
  </div>
</section>

<style>
  .contact {
    overflow: clip;
    isolation: isolate;
    padding-bottom: clamp(80px, 10vw, 140px);
  }

  .contact__glow {
    position: absolute;
    inset: 20% -20% -40%;
    z-index: -1;
    background: radial-gradient(45% 50% at 50% 60%, color-mix(in srgb, var(--glow) 85%, transparent), transparent 70%);
    filter: blur(30px);
  }

  .contact__inner {
    display: grid;
    gap: 28px;
  }

  .contact__title {
    max-width: 14ch;
  }

  .contact__email {
    display: inline-flex;
    align-items: center;
    gap: clamp(12px, 2vw, 24px);
    justify-self: start;
    max-width: 100%;
    margin-top: 12px;
    font-weight: 600;
    font-size: clamp(1.5rem, 5vw, 4rem);
    letter-spacing: -0.04em;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .contact__email-text {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0 2px no-repeat;
    transition: background-size 0.6s var(--ease-out);
  }

  .contact__email:hover .contact__email-text,
  .contact__email:focus-visible .contact__email-text {
    background-size: 100% 2px;
  }

  .contact__email-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: clamp(44px, 6vw, 72px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--accent);
    color: var(--accent-ink);
    transition: transform 0.5s var(--ease-out);
  }

  .contact__email:hover .contact__email-icon {
    transform: rotate(45deg);
  }

  .contact__email-icon :global(svg) {
    width: 45%;
    height: 45%;
  }

  .contact__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 28px;
    margin-top: 20px;
  }

  .contact__meta [hidden] {
    display: none;
  }

  .contact__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.3em;
    transition:
      color 0.2s var(--ease-out),
      text-decoration-color 0.2s var(--ease-out);
  }

  .contact__link:hover {
    color: var(--ink);
    text-decoration-color: currentColor;
  }

  .contact__link :global(svg) {
    width: 16px;
    height: 16px;
    flex: none;
  }

  /* CV: one document card with a single primary action. */
  .cv {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 20px 32px;
    margin-top: clamp(40px, 6vw, 72px);
    padding: 22px 28px 22px 24px;
    border: 1px solid var(--line);
    border-radius: var(--radius-l);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    backdrop-filter: blur(14px) saturate(1.3);
    -webkit-backdrop-filter: blur(14px) saturate(1.3);
  }

  .cv__paper {
    position: relative;
    width: 64px;
    height: 84px;
    margin: 4px 6px 4px 2px;
  }

  .cv__sheet {
    position: absolute;
    inset: 0;
    display: grid;
    align-content: start;
    gap: 5px;
    padding: 10px 9px;
    border-radius: 5px;
    background: #fbf8f2;
    box-shadow:
      0 1px 2px rgba(22, 27, 40, 0.12),
      0 8px 18px rgba(22, 27, 40, 0.12);
    transition: transform 0.5s var(--ease-out);
  }

  .cv__sheet--back {
    background: #eee7da;
    transform: rotate(-7deg) translate(-4px, 2px);
  }

  .cv__line {
    height: 3px;
    border-radius: 2px;
    background: rgba(22, 27, 40, 0.16);
  }

  .cv__line--name {
    width: 70%;
    height: 5px;
    background: #1c2540;
  }

  .cv__line--role {
    width: 45%;
    margin-bottom: 4px;
    background: rgba(28, 37, 64, 0.45);
  }

  .cv__line--short {
    width: 62%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .cv:hover .cv__sheet:not(.cv__sheet--back) {
      transform: translateY(-3px) rotate(2deg);
    }

    .cv:hover .cv__sheet--back {
      transform: rotate(-10deg) translate(-7px, 3px);
    }
  }

  .cv__body {
    display: grid;
    gap: 4px;
  }

  .cv__title {
    font-weight: 600;
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }

  .cv__lead {
    color: var(--ink-2);
    font-size: 0.9375rem;
  }

  .cv__meta {
    margin-top: 4px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }

  .cv__actions {
    display: grid;
    justify-items: center;
    gap: 8px;
  }

  .cv__alt {
    font-size: 0.8125rem;
    color: var(--muted);
    white-space: nowrap;
  }

  .cv__alt a {
    display: inline-flex;
    align-items: baseline;
    gap: 0.2em;
    white-space: nowrap;
    color: var(--ink-2);
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.25em;
  }

  .cv__alt a:hover {
    color: var(--ink);
  }

  .cv__alt a :global(svg) {
    display: inline-block;
    align-self: center;
    width: 0.85em;
    height: 0.85em;
    flex: none;
  }

  @media (max-width: 720px) {
    .cv__alt {
      white-space: normal;
    }

    .cv__alt a {
      padding-block: 12px;
    }

    .cv {
      grid-template-columns: auto minmax(0, 1fr);
      padding: 20px;
    }

    .cv__actions {
      grid-column: 1 / -1;
      justify-items: stretch;
      text-align: center;
    }
  }

  .contact__location {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 720px) {
    .contact__location {
      margin-left: 0;
      width: 100%;
    }
  }
</style>
