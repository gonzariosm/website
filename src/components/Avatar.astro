---
// Illustrated 3D avatar built from layered WebP images (see scripts/build-avatar.py
// in the private repo). The figure breathes and tilts toward the pointer; the
// blink layer flashes on a timer and the talk layer (mouth open) fades in with
// the narration's amplitude via the --level / --talk custom properties.
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
const srcset = (layer: string) => `/avatar/${layer}-360.webp 360w, /avatar/${layer}-500.webp 500w`;
// Mirrors the .hero__stage widths in Hero.astro.
const sizes = '(min-width: 961px) clamp(170px, 16.5vw, 240px), (min-height: 900px) min(42vw, 200px), min(36vw, 160px)';
---

<div class:list={['avatar', className]} aria-hidden="true" data-avatar>
  <span class="av-shadow"></span>
  <div class="av-body">
    <div class="av-gaze" data-avatar-face>
      <span class="av-ring av-ring--1"></span>
      <span class="av-ring av-ring--2"></span>
      <img
        class="av-layer"
        src="/avatar/figure-360.webp"
        srcset={srcset('figure')}
        sizes={sizes}
        width="533"
        height="1501"
        alt=""
        fetchpriority="high"
        decoding="async"
      />
      <img
        class="av-layer av-blink"
        src="/avatar/blink-360.webp"
        srcset={srcset('blink')}
        sizes={sizes}
        width="533"
        height="1501"
        alt=""
        decoding="async"
      />
      <img
        class="av-layer av-talk"
        src="/avatar/talk-360.webp"
        srcset={srcset('talk')}
        sizes={sizes}
        width="533"
        height="1501"
        alt=""
        decoding="async"
      />
    </div>
  </div>
</div>

<style>
  .avatar {
    --level: 0;
    --talk: 0;
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 533 / 1501;
  }

  .av-body,
  .av-gaze {
    position: absolute;
    inset: 0;
    transform-origin: 50% 100%;
  }

  .av-body {
    perspective: 900px;
  }

  .av-gaze {
    transition: transform 0.6s var(--ease-out);
  }

  .av-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    user-select: none;
    -webkit-user-drag: none;
  }

  .av-blink {
    opacity: 0;
  }

  .av-talk {
    opacity: min(1, calc(var(--talk) * var(--level) * 1.8));
  }

  .av-shadow {
    position: absolute;
    left: 50%;
    bottom: -1.5%;
    width: 78%;
    height: 3.5%;
    translate: -50% 0;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--ink) 30%, transparent), transparent);
  }

  /* Voice rings centred on the head (coordinates of the cropped figure). */
  .av-ring {
    position: absolute;
    left: 54.2%;
    top: 8.7%;
    width: 40%;
    aspect-ratio: 1;
    translate: -50% -50%;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
    opacity: calc(var(--talk) * (0.12 + var(--level) * 0.4));
    transform: scale(calc(0.96 + var(--level) * 0.1));
  }

  .av-ring--2 {
    width: 52%;
    opacity: calc(var(--talk) * (0.06 + var(--level) * 0.25));
    transform: scale(calc(0.94 + var(--level) * 0.16));
  }

  @media (prefers-color-scheme: dark) {
    .av-shadow {
      background: radial-gradient(closest-side, rgba(0, 0, 0, 0.55), transparent);
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .av-body {
      animation: av-breathe 5.5s var(--ease-in-out) infinite;
    }

    .av-blink {
      animation: av-blink 6s infinite;
    }
  }

  @keyframes av-breathe {
    0%,
    100% {
      transform: scale(1, 1);
    }
    50% {
      transform: scale(1.004, 1.01);
    }
  }

  @keyframes av-blink {
    0%,
    46.5%,
    49.5%,
    100% {
      opacity: 0;
    }
    47.5%,
    48.5% {
      opacity: 1;
    }
  }
</style>
