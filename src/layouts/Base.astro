---
import '../styles/global.css';
import { copy, person, homePath, markdownPath, htmlLang, ogLocale, type Locale } from '../content/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of this page without locale prefix, e.g. "/" */
  noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const t = copy[locale];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site ?? new URL(person.site);
// Canonical URLs always point at production. A preview build (SITE_URL set to
// another origin, e.g. a tunnel) keeps its own og:url / og:image so social
// previews work, but is marked noindex so it never competes with the real site.
const production = new URL(person.site);
const isPreview = site.origin !== production.origin;
const canonical = new URL(homePath(locale), production).href;
const alternates = [
  { hreflang: 'en', href: new URL(homePath('en'), production).href },
  { hreflang: 'es', href: new URL(homePath('es'), production).href },
  { hreflang: 'x-default', href: new URL(homePath('en'), production).href },
];
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';
// Social card per locale (built by scripts/build-og.mjs in the private repo).
const ogImage = new URL(`/og/${locale}.jpg`, site).href;
const ogImageAlt = `${person.name}: ${t.hero.titleLines.join(' ')} ${t.meta.ogTagline} ${t.meta.ogImageAlt}`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.href}#person`,
      name: person.name,
      jobTitle: locale === 'en' ? 'Director of AI Platform' : 'Director de Plataforma de IA',
      worksFor: { '@type': 'Organization', name: 'Rebrandly' },
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
      email: `mailto:${person.email}`,
      url: site.href,
      image: new URL('/avatar/face-320.webp', site).href,
      sameAs: [person.linkedin, person.github],
      knowsLanguage: ['es', 'en'],
      knowsAbout: ['AI platforms', 'AI-assisted software engineering', 'Coding agents', 'LLM evaluation', 'Model Context Protocol', 'Platform engineering', 'DevOps', 'Site Reliability Engineering', 'AWS', 'Kubernetes', 'Terraform'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: person.name,
      inLanguage: htmlLang[locale],
      publisher: { '@id': `${site.href}#person` },
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {(noindex || isPreview) && <meta name="robots" content="noindex" />}
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownPath(locale)} title="Markdown" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(homePath(locale), site).href} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="profile:first_name" content="Gonzalo" />
    <meta property="profile:last_name" content="Ríos" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__motionReady) document.documentElement.classList.add('reveal-all');
      }, 3000);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
