---
import Icon from './Icon.astro';
import { copy, sectionIds, homePath, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const other: Locale = locale === 'en' ? 'es' : 'en';
---

<header class="site-header" data-header>
  <div class="site-header__inner">
    <a class="monogram" href={homePath(locale)} aria-label={`GR, ${t.nav.home}`}>
      <span aria-hidden="true">GR</span>
    </a>

    <nav class="pill" aria-label={t.nav.label}>
      <div class="pill__track">
      <span class="pill__indicator" data-nav-indicator aria-hidden="true"></span>
      <ul role="list" class="pill__list" data-nav-list>
        {
          sectionIds.map((id) => (
            <li>
              <a class="pill__link" href={`#${id}`} data-nav-link={id}>
                {t.nav[id]}
              </a>
            </li>
          ))
        }
      </ul>
      </div>
    </nav>

    <a
      class="lang"
      href={homePath(other)}
      hreflang={other}
      lang={other}
      aria-label={`${t.langSwitch.short}, ${t.langSwitch.label}`}
      data-lang-switch
    >
      <Icon name="globe" />
      <span aria-hidden="true">{t.langSwitch.short}</span>
    </a>
  </div>
  <div class="progress" aria-hidden="true"><span data-progress></span></div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    padding: max(12px, env(safe-area-inset-top)) var(--gutter) 0;
    pointer-events: none;
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    max-width: var(--max);
    margin-inline: auto;
  }

  .monogram,
  .lang,
  .pill {
    pointer-events: auto;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
    border: 1px solid var(--line);
    backdrop-filter: blur(18px) saturate(1.6);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    box-shadow: var(--shadow-1);
  }

  .monogram {
    display: grid;
    place-items: center;
    flex: none;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    font-weight: 700;
    font-size: 0.8125rem;
    letter-spacing: 0.02em;
    text-decoration: none;
  }

  .pill {
    min-width: 0;
    border-radius: 999px;
    padding: 4px;
    overflow-x: auto;
    scrollbar-width: none;
    overscroll-behavior-x: contain;
  }

  .pill::-webkit-scrollbar {
    display: none;
  }

  .pill__track {
    position: relative;
  }

  .pill__list {
    position: relative;
    display: flex;
    gap: 2px;
    margin: 0;
  }

  .pill__link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.3s var(--ease-out);
  }

  .pill__link:hover {
    color: var(--ink);
  }

  .pill__link[aria-current='true'] {
    color: var(--accent-ink);
  }

  .pill__indicator {
    position: absolute;
    top: 0;
    left: 0;
    height: 36px;
    width: 0;
    border-radius: 999px;
    background: var(--accent);
    opacity: 0;
    transition:
      transform 0.5s var(--ease-out),
      width 0.5s var(--ease-out),
      opacity 0.3s var(--ease-out);
  }

  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    flex: none;
    height: 44px;
    padding: 0 14px;
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
  }

  .lang :global(svg) {
    width: 16px;
    height: 16px;
  }

  .progress {
    position: fixed;
    inset: 0 0 auto;
    height: 2px;
  }

  .progress span {
    display: block;
    height: 100%;
    background: var(--ink);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  @media (max-width: 720px) {
    .pill {
      mask-image: linear-gradient(90deg, transparent 0, #000 12px, #000 calc(100% - 12px), transparent 100%);
    }

    .pill__link {
      padding: 0 12px;
    }
  }
</style>
