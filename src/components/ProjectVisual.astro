---
// Decorative, code-drawn illustrations for each project panel. Always
// rendered inside an aria-hidden container; the panel text carries the facts.
import type { ProjectVisual } from '../content/site';

interface Props {
  kind: ProjectVisual;
}
const { kind } = Astro.props;
const dots = Array.from({ length: 96 }, (_, i) => ({ i, d: ((i * 37) % 23) / 10 }));
const tf = [
  '<span class="k">resource</span> <span class="s">"sitehost_server"</span> <span class="s">"web"</span> {',
  '  label    = <span class="s">"web-01"</span>',
  '  location = <span class="s">"AKLCITY"</span>',
  '  image    = <span class="s">"ubuntu-noble"</span>',
  '}',
  '',
  '<span class="c">$ terraform apply</span>',
  '<span class="ok">Apply complete! Resources: 1 added.</span>',
].join('\n');
const bars = [62, 78, 54, 91, 70, 88, 96, 74, 83, 99, 87, 93];
---

<div class:list={['pv', `pv--${kind}`]}>
  <span class="pv__tag">Illustrative · UI</span>

  {
    kind === 'platform' && (
      <div class="pv-card pv-platform">
        <div class="pv-row pv-row--head">
          <span>agents</span>
          <span>eval</span>
        </div>
        {[
          ['support-triage', '98%', 'ok'],
          ['link-insights', '95%', 'ok'],
          ['brand-guard', '91%', 'warn'],
          ['report-writer', '97%', 'ok'],
        ].map(([name, score, state]) => (
          <div class="pv-row">
            <span class:list={['pv-status', state]} />
            <span class="pv-name">{name}</span>
            <span class="pv-score">{score}</span>
          </div>
        ))}
        <div class="pv-ring">
          <svg viewBox="0 0 64 64">
            <circle cx="32" cy="32" r="26" class="pv-ring__track" />
            <circle cx="32" cy="32" r="26" class="pv-ring__value" pathLength="100" />
          </svg>
          <span>
            <strong>96</strong>
            <small>quality</small>
          </span>
        </div>
      </div>
    )
  }

  {
    kind === 'ingest' && (
      <div class="pv-card pv-ingest">
        <p class="pv-metric">
          &lt;1<small>s</small>
        </p>
        <p class="pv-caption">bulk write · DynamoDB</p>
        <div class="pv-bars">
          {bars.map((h, i) => (
            <i style={`--h:${h}%; --i:${i}`} />
          ))}
        </div>
        <div class="pv-legend">
          <span>batch 25</span>
          <span>parallel ×64</span>
          <span>p99 ok</span>
        </div>
      </div>
    )
  }

  {
    kind === 'containers' && (
      <div class="pv-card pv-containers">
        <div class="pv-dots">
          {dots.map((d) => (
            <i style={`--d:${d.d}s`} />
          ))}
        </div>
        <p class="pv-caption">15,000+ containers · healthy</p>
      </div>
    )
  }

  {
    kind === 'terraform' && (
      <div class="pv-card pv-code">
        <div class="pv-code__bar">
          <i />
          <i />
          <i />
          <span>main.tf</span>
        </div>
        <pre><code set:html={tf} /></pre>
      </div>
    )
  }

  {
    kind === 'hosting' && (
      <div class="pv-card pv-hosting">
        <div class="pv-ring pv-ring--big">
          <svg viewBox="0 0 64 64">
            <circle cx="32" cy="32" r="26" class="pv-ring__track" />
            <circle cx="32" cy="32" r="26" class="pv-ring__value" pathLength="100" />
          </svg>
          <span>
            <strong>1,000+</strong>
            <small>clients</small>
          </span>
        </div>
        <ul class="pv-list">
          <li>
            <span>Dedicated</span>
            <i style="--w:72%" />
          </li>
          <li>
            <span>AWS</span>
            <i style="--w:54%" />
          </li>
          <li>
            <span>DigitalOcean</span>
            <i style="--w:38%" />
          </li>
        </ul>
      </div>
    )
  }
</div>

<style>
  .pv {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 28px;
  }

  .pv__tag {
    position: absolute;
    left: 16px;
    bottom: 12px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .pv-card {
    position: relative;
    width: min(100%, 360px);
    padding: 20px;
    border-radius: var(--radius-m);
    background: var(--surface-2);
    border: 1px solid var(--line);
    box-shadow: var(--shadow-2);
  }

  .pv-caption {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* platform */
  .pv-platform {
    display: grid;
    gap: 10px;
    padding-right: 120px;
  }

  .pv-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }

  .pv-row--head {
    justify-content: space-between;
    color: var(--muted);
    font-size: 0.625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .pv-name {
    flex: 1;
  }

  .pv-score {
    color: var(--muted);
  }

  .pv-status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--signal) 18%, transparent);
  }

  .pv-status.warn {
    background: #d9a21b;
    box-shadow: 0 0 0 4px rgba(217, 162, 27, 0.18);
  }

  .pv-ring {
    position: absolute;
    right: 16px;
    top: 50%;
    width: 96px;
    translate: 0 -50%;
    display: grid;
    place-items: center;
  }

  .pv-ring svg {
    width: 100%;
    transform: rotate(-90deg);
  }

  .pv-ring__track {
    fill: none;
    stroke: var(--line);
    stroke-width: 6;
  }

  .pv-ring__value {
    fill: none;
    stroke: var(--accent);
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 96 100;
  }

  .pv-ring > span {
    position: absolute;
    display: grid;
    text-align: center;
    line-height: 1.1;
  }

  .pv-ring strong {
    font-size: 1.25rem;
  }

  .pv-ring small {
    font-size: 0.625rem;
    color: var(--muted);
  }

  /* ingest */
  .pv-ingest {
    display: grid;
    gap: 6px;
  }

  .pv-metric {
    font-weight: 700;
    font-size: 4.5rem;
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .pv-metric small {
    font-size: 2rem;
    color: var(--muted);
  }

  .pv-bars {
    display: flex;
    align-items: end;
    gap: 6px;
    height: 110px;
    margin-top: 12px;
  }

  .pv-bars i {
    flex: 1;
    height: var(--h);
    border-radius: 4px 4px 2px 2px;
    background: linear-gradient(var(--accent), color-mix(in srgb, var(--accent) 40%, transparent));
    transform-origin: bottom;
  }

  .pv-legend {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    margin-top: 6px;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    color: var(--muted);
  }

  /* containers */
  .pv-containers {
    display: grid;
    gap: 14px;
  }

  .pv-dots {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 7px;
  }

  .pv-dots i {
    aspect-ratio: 1;
    border-radius: 3px;
    background: var(--signal);
    opacity: 0.25;
  }

  /* terraform */
  .pv-code {
    padding: 0;
    overflow: hidden;
    background: #11141c;
    color: #e8e4da;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .pv-code__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 10px 14px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: #9a978f;
  }

  .pv-code__bar i {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: #3a3f4c;
  }

  .pv-code__bar span {
    margin-left: 8px;
  }

  .pv-code pre {
    margin: 0;
    padding: 16px;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    line-height: 1.7;
    white-space: pre-wrap;
  }

  .pv-code code {
    display: block;
    white-space: pre;
    overflow-x: auto;
  }

  .pv-code .k {
    color: #c3a6ff;
  }

  .pv-code .s {
    color: #f2d58a;
  }

  .pv-code .c {
    color: #8b8f9c;
  }

  .pv-code .ok {
    color: #6fdba0;
  }

  /* hosting */
  .pv-hosting {
    display: grid;
    grid-template-columns: 120px 1fr;
    align-items: center;
    gap: 20px;
  }

  .pv-ring--big {
    position: relative;
    right: auto;
    top: auto;
    translate: none;
    width: 120px;
  }

  .pv-hosting .pv-ring__value {
    stroke-dasharray: 82 100;
  }

  .pv-ring--big strong {
    font-size: 1rem;
  }

  .pv-list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.75rem;
  }

  .pv-list li {
    display: grid;
    gap: 4px;
  }

  .pv-list i {
    display: block;
    height: 6px;
    width: var(--w);
    border-radius: 999px;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global(.panel.is-open) .pv-bars i {
      animation: pv-grow 1.1s var(--ease-out) both;
      animation-delay: calc(var(--i) * 50ms + 300ms);
    }

    :global(.panel.is-open) .pv-dots i {
      animation: pv-blink 3.2s ease-in-out infinite;
      animation-delay: var(--d);
    }

    :global(.panel.is-open) .pv-ring__value {
      animation: pv-ring 1.4s var(--ease-out) both 0.3s;
    }

    :global(.panel.is-open) .pv-list i {
      animation: pv-width 1.1s var(--ease-out) both 0.4s;
    }
  }

  @keyframes pv-grow {
    from {
      transform: scaleY(0.05);
    }
  }

  @keyframes pv-blink {
    0%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }

  @keyframes pv-ring {
    from {
      stroke-dasharray: 0 100;
    }
  }

  @keyframes pv-width {
    from {
      width: 0;
    }
  }

  @media (max-width: 520px) {
    .pv {
      padding: 16px 16px 32px;
    }

    .pv-platform {
      padding-right: 20px;
      padding-bottom: 130px;
    }

    .pv-platform .pv-ring {
      top: auto;
      bottom: 16px;
      right: 50%;
      translate: 50% 0;
    }

    .pv-hosting {
      grid-template-columns: 1fr;
      justify-items: center;
    }

    .pv-hosting .pv-list {
      width: 100%;
    }

    .pv-metric {
      font-size: 3.5rem;
    }
  }
</style>
