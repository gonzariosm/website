---
import '../styles/global.css';
import { copy, person, homePath, markdownPath, htmlLang, ogLocale, type Locale } from '../content/site';

interface Props {
  locale: Locale;
  title?: string;
  description?: string;
  /** Path of this page without locale prefix, e.g. "/" */
  noindex?: boolean;
}

const { locale, noindex = false } = Astro.props;
const t = copy[locale];
const title = Astro.props.title ?? t.meta.title;
const description = Astro.props.description ?? t.meta.description;
const site = Astro.site ?? new URL(person.site);
const canonical = new URL(homePath(locale), site).href;
const alternates = [
  { hreflang: 'en', href: new URL(homePath('en'), site).href },
  { hreflang: 'es', href: new URL(homePath('es'), site).href },
  { hreflang: 'x-default', href: new URL(homePath('en'), site).href },
];
const otherLocale: Locale = locale === 'en' ? 'es' : 'en';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Person',
      '@id': `${site.href}#person`,
      name: person.name,
      jobTitle: locale === 'en' ? 'Director of AI Platform' : 'Director de Plataforma de IA',
      worksFor: { '@type': 'Organization', name: 'Rebrandly' },
      address: { '@type': 'PostalAddress', addressLocality: 'Barcelona', addressCountry: 'ES' },
      email: `mailto:${person.email}`,
      url: site.href,
      sameAs: [person.linkedin, person.github],
      knowsLanguage: ['es', 'en'],
      knowsAbout: ['DevOps', 'Site Reliability Engineering', 'Cloud architecture', 'AWS', 'Kubernetes', 'Terraform', 'AI platforms'],
    },
    {
      '@type': 'WebSite',
      '@id': `${site.href}#website`,
      url: site.href,
      name: person.name,
      inLanguage: htmlLang[locale],
      publisher: { '@id': `${site.href}#person` },
    },
  ],
};
---

<!doctype html>
<html lang={htmlLang[locale]} dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={person.name} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    {!noindex && alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
    {!noindex && <link rel="alternate" type="text/markdown" href={markdownPath(locale)} title="Markdown" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f3eee4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0c10" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={ogLocale[locale]} />
    <meta property="og:locale:alternate" content={ogLocale[otherLocale]} />
    <meta property="profile:first_name" content="Gonzalo" />
    <meta property="profile:last_name" content="Ríos" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script is:inline>
      document.documentElement.classList.add('js');
      setTimeout(function () {
        if (!window.__motionReady) document.documentElement.classList.add('reveal-all');
      }, 3000);
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <slot />
  </body>
</html>
