---
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Hero from './Hero.astro';
import About from './About.astro';
import Statement from './Statement.astro';
import Skills from './Skills.astro';
import Work from './Work.astro';
import Experience from './Experience.astro';
import Achievements from './Achievements.astro';
import Contact from './Contact.astro';
import Footer from './Footer.astro';
import VoicePlayer from './VoicePlayer.astro';
import { copy, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<Base locale={locale}>
  <a class="skip-link" href="#main">{t.skipLink}</a>
  <Nav locale={locale} />
  <main id="main" tabindex="-1">
    <Hero locale={locale} />
    <About locale={locale} />
    <Statement locale={locale} />
    <Skills locale={locale} />
    <Work locale={locale} />
    <Experience locale={locale} />
    <Achievements locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <VoicePlayer locale={locale} />
</Base>

<script>
  import '../scripts/main.ts';
</script>

<style>
  main:focus {
    outline: none;
  }
</style>
