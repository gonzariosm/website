---
import Avatar from './Avatar.astro';
import Icon from './Icon.astro';
import ListenButton from './ListenButton.astro';
import { copy, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section id="top" class="hero" aria-labelledby="hero-title" data-hero>
  <div class="hero__glow" aria-hidden="true"></div>
  <p class="hero__word" aria-hidden="true" data-hero-word>
    {'GONZALO'.split('').map((ch) => <span>{ch}</span>)}
  </p>

  <div class="hero__stage" data-hero-stage>
    <Avatar class="hero__avatar" />
  </div>

  <div class="hero__inner container">
    <div class="hero__copy" data-hero-copy>
      <h1 id="hero-title" class="hero__title">
        <span class="eyebrow hero__eyebrow" data-hero-line>{t.hero.eyebrow}</span>
        <span class="display hero__display">
          <span class="hero__mask"><span data-hero-line>{t.hero.titleLines[0]}</span></span>
          <span class="hero__mask"><span data-hero-line>{t.hero.titleLines[1]}</span></span>
        </span>
      </h1>
      <p class="lead hero__lead" data-hero-line>{t.hero.lead}</p>
      <div class="hero__ctas" data-hero-line>
        <a class="btn" href="#work">
          {t.hero.ctaWork}
          <Icon name="arrow-down" />
        </a>
        <a class="btn btn--ghost" href="#contact">{t.hero.ctaTalk}</a>
      </div>
    </div>

    <div class="hero__side" data-hero-line>
      <ListenButton locale={locale} clip="intro" variant="hero" label={t.hero.listen} sectionTitle="Intro" />
    </div>
  </div>

  <a class="hero__scroll" href="#about">
    <span>{t.hero.scroll}</span>
    <span class="hero__scroll-line" aria-hidden="true"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: end;
    padding-top: 96px;
    padding-bottom: clamp(72px, 9vh, 120px);
    overflow: clip;
    isolation: isolate;
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 120%;
    z-index: -2;
    background:
      radial-gradient(40% 40% at 55% 40%, color-mix(in srgb, var(--glow) 90%, transparent), transparent 70%),
      radial-gradient(30% 30% at 75% 20%, color-mix(in srgb, var(--glow-2) 60%, transparent), transparent 70%);
    filter: blur(20px);
    opacity: 0.9;
  }

  .hero__word {
    position: absolute;
    inset: 12% 0 auto;
    z-index: -1;
    display: flex;
    justify-content: center;
    font-weight: 800;
    font-size: clamp(5rem, 24vw, 26rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--ink);
    opacity: 0.055;
    white-space: nowrap;
    user-select: none;
    pointer-events: none;
  }

  .hero__word span {
    display: inline-block;
  }

  .hero__stage {
    position: absolute;
    left: 63%;
    bottom: 0;
    z-index: 0;
    width: clamp(170px, 16.5vw, 240px);
    translate: -50% 0;
    pointer-events: none;
  }

  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: end;
    gap: 32px;
  }

  .hero__copy {
    display: grid;
    gap: 24px;
    max-width: min(600px, 46vw);
  }

  .hero__display {
    font-size: clamp(2.75rem, 6.2vw, 5.75rem);
  }

  .hero__title {
    display: grid;
    gap: 18px;
    font-weight: inherit;
  }

  .hero__display {
    display: grid;
  }

  .hero__mask {
    display: block;
    overflow: clip;
    padding-bottom: 0.08em;
  }

  .hero__mask > span {
    display: block;
  }

  .hero__lead {
    max-width: 44ch;
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .hero__side {
    display: grid;
    justify-items: end;
    gap: 12px;
    padding-bottom: 6px;
  }

  .hero__scroll {
    position: absolute;
    left: var(--gutter);
    bottom: 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
    text-decoration: none;
    z-index: 2;
  }

  .hero__scroll-line {
    order: -1;
    width: 1px;
    height: 32px;
    background: linear-gradient(var(--muted), transparent);
    transform-origin: top;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__scroll-line {
      animation: scroll-line 2.2s var(--ease-in-out) infinite;
    }
  }

  @keyframes scroll-line {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    60% {
      transform: scaleY(1);
      opacity: 1;
    }
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  @media (max-width: 960px) {
    .hero {
      align-items: start;
      padding-top: 84px;
    }

    .hero__stage {
      position: relative;
      left: auto;
      bottom: auto;
      translate: none;
      width: min(36vw, 160px);
      margin: 0 auto -8px;
    }

    .hero__word {
      inset: 14% 0 auto;
    }

    .hero__inner {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .hero__copy {
      max-width: 640px;
    }

    .hero__side {
      justify-items: start;
      order: -1;
    }

    .hero__scroll {
      display: none;
    }
  }

  @media (max-width: 960px) and (min-height: 900px) {
    .hero__stage {
      width: min(42vw, 200px);
    }
  }
</style>
