---
import Icon from './Icon.astro';
import { copy, markdownPath, homePath, type Locale } from '../content/site';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
const other: Locale = locale === 'en' ? 'es' : 'en';
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <p>© {year} {t.footer.rights}</p>
    <p class="footer__made">
      {t.footer.madeWith}
      <Icon name="heart" class="footer__heart" />
      <span class="visually-hidden">{t.footer.love}</span>
      {t.footer.byAgents}
    </p>
    <ul role="list" class="footer__links">
      <li><a href={markdownPath(locale)} type="text/markdown">{t.footer.markdown}</a></li>
      <li>
        <a href={homePath(other)} hreflang={other} lang={other}>{t.langSwitch.full}</a>
      </li>
      <li><a href="#top">{t.footer.top}</a></li>
    </ul>
  </div>
</footer>

<style>
  .footer {
    padding-block: 32px max(32px, env(safe-area-inset-bottom));
    border-top: 1px solid var(--line);
    font-size: 0.8125rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
  }

  .footer__made {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    color: var(--muted);
  }

  .footer__made :global(.footer__heart) {
    width: 1.15em;
    height: 1.15em;
    color: #d6457a;
  }

  @media (prefers-reduced-motion: no-preference) {
    .footer__made :global(.footer__heart) {
      animation: heartbeat 1.6s var(--ease-out) infinite;
      transform-origin: 50% 60%;
    }
  }

  @keyframes heartbeat {
    0%,
    40%,
    100% {
      transform: scale(1);
    }
    12% {
      transform: scale(1.22);
    }
    24% {
      transform: scale(1.08);
    }
  }

  .footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0 0 0 auto;
  }

  .footer__links a {
    color: var(--ink-2);
    text-decoration-color: var(--line-strong);
  }

  .footer__links a:hover {
    color: var(--ink);
  }

  @media (max-width: 720px) {
    .footer__links {
      margin-left: 0;
    }
  }
</style>
